  m_Name: Confidence Rating Questionnaire
  m_EditorClassIdentifier: VERA::VERA.VERASurveyInfo
  surveyName: Confidence Rating Questionnaire
  surveyDescription: In this questionnaire, you will rate how confident you were
    in your ability to consistently and accurately shoot pumpkins.
  surveyEndStatement: Thank you for completing this survey.
  surveyQuestions:
  - questionType: 3
    questionText: 'Rate how strongly you agree or disagree with the following statements:'
    orderInSurvey: 1
    questionId: 69b1a92be2dfe7bd23c62b18
    selectionOptions: []
    leftSliderText: 
    rightSliderText: 
    matrixColumnTexts:
    - Strongly Disagree
    - Disagree
    - Neutral
    - Agree
    - Strongly Agree
    matrixRowTexts:
    - I was able to consistently and accurately hit the pumpkins I was shooting.
    - The environment hindered my ability to shoot the pumpkins.
    - The laser always fired in the exact direction I was aiming.
    - I felt confident in my abilities to shoot at the pumpkins.
  surveyId: 69b1a92be2dfe7bd23c62b16
